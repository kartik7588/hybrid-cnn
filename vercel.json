{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{node_modules/**,dist/**,src/**,public/**,scripts/**,docs/**,artifacts/**,ml/image/**,ml/0*.py,ml/10_try_api.py,.git/**}"
    }
  }
}
